{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth Planner",
  "version": "0.1.0",
  "identifier": "dev.usehearth.planner",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "mkdir -p gen/hearth-assets && cargo build --release && hearth asset bundle --release --out gen/hearth-assets"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "gen/hearth-assets/": "assets/"
    }
  }
}
