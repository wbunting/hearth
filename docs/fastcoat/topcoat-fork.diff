+		const sub = live.subscribeChanges(() => queueMicrotask(reconcile));
+		live.onFirstReady(() => {
+			reconcile();
+			(window as any).__fastcoatQueryMs = performance.now() - tq;
+		});
+		unsub = () => sub.unsubscribe();
+		reconcile();
