+		}
+		wrapper.style.display = on ? "contents" : "none";
+	});
+}
+
+function decode(s: string): string {
+	return s.replace(/&quot;/g, '"').replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");
+}
